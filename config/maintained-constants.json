  "constants": {
    "Framework.version": {
      "type": "version",
      "parts": 3,
      "value": "0.20.0",
      "description": "PhobosFramework published source/package version.",
      "targets": [
        {
          "path": "src/PhobosFramework/Plugin.cs",
          "pattern": "\\bVersion\\s*=\\s*\"(?P<value>[0-9.]+)\"",
          "count": 1
        },
        {
          "path": "src/PhobosFramework/PhobosFramework.csproj",
          "pattern": "<Version>(?P<value>[0-9.]+)</Version>",
          "count": 1
        },
        {
          "path": "mods/PhobosFramework/mod_info.json",
          "pattern": "\"strModVersion\"\\s*:\\s*\"(?P<value>[0-9.]+)\"",
          "count": 1
        },
        {
          "path": "README.md",
          "pattern": "\\|\\ \\*\\*Phobos\\ Framework\\*\\*\\ \\|\\ (?P<value>[0-9.]+) \\|",
          "count": 1
        },
        {
          "path": "docs/player-guide.md",
          "pattern": "\\*\\*Prepared versions:\\*\\* Phobos Framework \\*\\*(?P<value>[0-9.]+)\\*\\*",
          "count": 1
        },
        {
          "path": "workshop/PhobosFramework/page.bbcode",
          "pattern": "^\\[b\\]Version:\\[/b\\] (?P<value>[0-9.]+)\\r?$",
          "count": 1
        }
      ],
      "review": [
        "Run scripts/build-framework.ps1 with your game path.",
        "Review release notes and version-specific prose; historical compatibility gates are intentionally unchanged.",
        "Author the new Draft changelog entry, review the Workshop page, and regenerate/check notes with scripts/workshop-release-notes.py."
      ]
    },
    "Framework.gameVersion": {
      "type": "version",
      "parts": 4,
