  <ItemGroup><EmbeddedResource Include="../../assets/phobos-industrial-console/source/PhobosIndustrialPanel.png" LogicalName="PhobosFramework.console.png" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../mods/PhobosFramework/framework/equipment-names.json" LogicalName="PhobosFramework.equipment-names.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../mods/PhobosFramework/framework/economy.json" LogicalName="PhobosFramework.economy.json" /></ItemGroup>
