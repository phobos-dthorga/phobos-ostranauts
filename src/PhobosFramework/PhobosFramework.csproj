<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Version>0.123.0</Version>
    <GameManaged>$(OstranautsPath)/Ostranauts_Data/Managed</GameManaged>
    <BepInExCore>$(OstranautsPath)/BepInEx/core</BepInExCore>
  </PropertyGroup>
  <Target Name="RequireLocalLoader" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameManaged)/Assembly-CSharp.dll')" Text="Supply OstranautsPath for a local game installation." />
    <Error Condition="!Exists('$(BepInExCore)/BepInEx.dll')" Text="Supply OstranautsPath for a local installation with BepInEx 5." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="../../external/phobos-scope/recording/Phobos.Scope.Recording/Phobos.Scope.Recording.csproj" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameManaged)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(GameManaged)/Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(GameManaged)/Newtonsoft.Json.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)/0Harmony.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExCore)/BepInEx.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameManaged)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(GameManaged)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameManaged)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameManaged)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManaged)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextCoreFontEngineModule" HintPath="$(GameManaged)/UnityEngine.TextCoreFontEngineModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(GameManaged)/UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(GameManaged)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(GameManaged)/UnityEngine.ImageConversionModule.dll" Private="false" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../translations/PhobosFramework/en.json" LogicalName="PhobosFramework.en.json" /></ItemGroup>
  <!-- Sounds (completion cue, machine loops) ship as loose files in the plugin's sounds folder since 0.120.0, copied by
       the package build from config/framework-sounds.json; the ElevenLabs loops stay excluded from the MIT grant
       (assets/phobos-audio/washer-motor-pump-v1/LICENSING.md). -->
  <ItemGroup><EmbeddedResource Include="../../assets/phobos-industrial-console/source/PhobosIndustrialPanel.png" LogicalName="PhobosFramework.console.png" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../mods/PhobosFramework/framework/equipment-names.json" LogicalName="PhobosFramework.equipment-names.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../mods/PhobosFramework/framework/economy.json" LogicalName="PhobosFramework.economy.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../mods/PhobosFramework/framework/vessels.json" LogicalName="PhobosFramework.vessels.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../mods/PhobosFramework/framework/lines.json" LogicalName="PhobosFramework.lines.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../mods/PhobosFramework/framework/story.json" LogicalName="PhobosFramework.story.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../mods/PhobosFramework/framework/upkeep.json" LogicalName="PhobosFramework.upkeep.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../mods/PhobosFramework/framework/stores.json" LogicalName="PhobosFramework.stores.json" /></ItemGroup>
</Project>
