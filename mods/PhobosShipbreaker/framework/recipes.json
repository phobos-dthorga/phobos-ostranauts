      "stationIds": [
        "ItmTable01",
        "ItmTable02"
      ],
      "ingredients": [
        {
          "trigger": "PhobosShipbreakerTSection",
          "item": "PhobosShipbreakerSection",
          "count": 2,
          "requireEmpty": true,
          "unitMassKg": 80
        }
      ],
      "outputs": [
        {
          "item": "PhobosShipbreakerLoose",
          "count": 1,
          "unitMassKg": 160
