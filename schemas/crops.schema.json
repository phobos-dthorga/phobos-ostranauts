{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/phobos-dthorga/phobos-ostranauts/schemas/crops.schema.json",
  "title": "Phobos crops data pack",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "priority": {
      "type": "integer",
      "minimum": -100,
      "maximum": 100,
      "description": "Override files only: files apply lowest first (default 0), so a higher number has a later word. Leave it out unless you need it."
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "schema": {
      "type": "string",
      "const": "crops"
    },
    "notes": {
      "type": "string",
      "description": "Free text for maintainers; ignored by the game."
    },
    "co2Response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notes": {
          "type": "string",
          "description": "Free text for maintainers; ignored by the game."
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 10,
                "description": "CO2 partial pressure, kPa"
              },
              {
                "type": "number",
                "minimum": 0.5,
                "maximum": 2,
                "description": "Growth factor"
              }
            ]
          },
          "description": "Points of [kPa, factor] in rising pressure; interpolated, ends held."
        }
      },
      "required": [
        "points"
      ],
      "description": "How room carbon dioxide speeds growth per hour and per kWh; budgets per kilogram are unchanged."
    },
    "growth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notes": {
          "type": "string",
          "description": "Free text for maintainers; ignored by the game."
        },
        "room": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "notes": {
              "type": "string",
              "description": "Free text for maintainers; ignored by the game."
            },
            "minC": {
              "type": "number",
              "minimum": -50,
              "maximum": 100,
              "description": "Coldest room the crop grows in, C."
            },
            "maxC": {
              "type": "number",
              "minimum": -50,
              "maximum": 100,
              "description": "Warmest room the crop grows in, C."
            },
            "minKPa": {
              "type": "number",
              "minimum": 0,
              "exclusiveMinimum": 0,
              "maximum": 500,
              "description": "Lowest pressure, kPa."
            },
            "maxKPa": {
              "type": "number",
              "minimum": 0,
              "exclusiveMinimum": 0,
              "maximum": 500,
              "description": "Highest pressure, kPa."
            }
          },
          "description": "A growing room. Each limit may be left out; a lower limit must stay below its upper one."
        },
        "stress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "notes": {
              "type": "string",
              "description": "Free text for maintainers; ignored by the game."
            },
            "graceHours": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000,
              "description": "Hours of stress a crop shrugs off."
            },
            "healthLossPerHour": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Health lost per further stressed hour in a room that suits the crop."
            },
            "healthLossPerHourOutside": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Health lost per further hour in a room outside its limits."
            },
            "healthLossPerHourNoAir": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Health lost per hour in a room with no air."
            },
            "plantWaterKg": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Water a rack needs before a crew order plants in it, kg."
            }
          }
        },
        "nutrientTargetKg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": 0,
          "maximum": 0.5,
          "description": "Nutrient a W2 keeps in each rack it feeds, kg."
        },
        "feedStrengthKgPerKg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Nutrient each kilogram of water the pump moves can carry, kg."
        },
        "crops": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z0-9-]+$": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "notes": {
                  "type": "string",
                  "description": "Free text for maintainers; ignored by the game."
                },
                "room": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "notes": {
                      "type": "string",
                      "description": "Free text for maintainers; ignored by the game."
                    },
                    "minC": {
                      "type": "number",
                      "minimum": -50,
                      "maximum": 100,
                      "description": "Coldest room the crop grows in, C."
                    },
                    "maxC": {
                      "type": "number",
                      "minimum": -50,
                      "maximum": 100,
                      "description": "Warmest room the crop grows in, C."
                    },
                    "minKPa": {
                      "type": "number",
                      "minimum": 0,
                      "exclusiveMinimum": 0,
                      "maximum": 500,
                      "description": "Lowest pressure, kPa."
                    },
                    "maxKPa": {
                      "type": "number",
                      "minimum": 0,
                      "exclusiveMinimum": 0,
                      "maximum": 500,
                      "description": "Highest pressure, kPa."
                    }
                  },
                  "description": "A growing room. Each limit may be left out; a lower limit must stay below its upper one."
                }
              }
            }
          },
          "description": "One crop's own room, by crop name; only what is given replaces the shared room."
        }
      },
      "description": "Where and how crops grow, and how a W2 feeds them. Every figure is optional."
    },
    "crops": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9-]+$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "notes": {
              "type": "string",
              "description": "Free text for maintainers; ignored by the game."
            },
            "name": {
              "type": "string",
              "description": "Plain name for a crop you add; shipped crops use the translation files."
            },
            "hours": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000,
              "description": "Lit hours to harvest at ordinary pace."
            },
            "kw": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1.5,
              "description": "Rack electrical demand while growing."
            },
            "seedKg": {
              "type": "number",
              "minimum": 0,
              "exclusiveMinimum": 0,
              "description": "Planted mass; one unit of the stock item."
            },
            "finalKg": {
              "type": "number",
              "minimum": 0,
              "exclusiveMinimum": 0,
              "description": "Harvest-ready mass of the cohort."
            },
            "carbonKg": {
              "type": "number",
              "minimum": 0,
              "exclusiveMinimum": 0,
              "description": "Carbon fixed over the cycle, as CH2O."
            },
            "nutrientKg": {
              "type": "number",
              "minimum": 0,
              "exclusiveMinimum": 0,
              "description": "Nutrient taken up."
            },
            "waterKg": {
              "type": "number",
              "minimum": 0,
              "exclusiveMinimum": 0,
              "description": "Water taken up."
            },
            "vapourKg": {
              "type": "number",
              "minimum": 0,
              "description": "Water transpired."
            },
            "seedCarbonKg": {
              "type": "number",
              "minimum": 0,
              "description": "Carbon the planting stock already holds."
            },
            "edibleKg": {
              "type": "number",
              "minimum": 0,
              "exclusiveMinimum": 0,
              "description": "Edible mass of a full healthy cohort."
            },
            "keptStockKg": {
              "type": "number",
              "minimum": 0,
              "description": "Planting stock kept back at harvest: zero or one planting."
            },
            "portionKg": {
              "type": "number",
              "minimum": 0,
              "exclusiveMinimum": 0,
              "description": "One portion; one unit of the produce item."
            },
            "picks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10,
              "description": "Picks a ripe plant allows before its final harvest; absent for a crop harvested once."
            },
            "pickKg": {
              "type": "number",
              "minimum": 0,
              "description": "Most fruit one pick takes, in whole portions."
            },
            "stock": {
              "type": "string",
              "description": "The item planted."
            },
            "produce": {
              "type": "string",
              "description": "The item each portion becomes."
            },
            "feed": {
              "type": "string",
              "description": "Old name, kept to read old saves: the feed a W2 mixed for this crop until Agriculture 0.54.0. Leave out for a new crop."
            },
            "feedCommodity": {
              "type": "string",
              "description": "Old name, kept to read old saves: what that feed was held under in conduit. Leave out for a new crop."
            },
            "art": {
              "type": "string",
              "description": "Artwork family of the growth stages; a crop that ships with the mod.",
              "pattern": "^[A-Za-z0-9]+$"
            }
          },
          "required": [
            "hours",
            "kw",
            "seedKg",
            "finalKg",
            "carbonKg",
            "nutrientKg",
            "waterKg",
            "vapourKg",
            "seedCarbonKg",
            "edibleKg",
            "keptStockKg",
            "portionKg",
            "stock",
            "produce",
            "art"
          ],
          "description": "Mass must close: waterKg + nutrientKg + 0.4 x carbonKg - vapourKg = finalKg - seedKg."
        }
      },
      "description": "Crops by the name a saved planting stores. A published crop is frozen: add a crop beside it."
    },
    "items": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^.+$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "notes": {
              "type": "string",
              "description": "Free text for maintainers; ignored by the game."
            },
            "text": {
              "type": "string",
              "description": "Translation key of the item name; its description is the key plus _desc. Left out for an item a file adds to the materials pack, which is named there."
            },
            "hunger": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "satiety": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          }
        }
      },
      "description": "The crop items the mod builds, by definition id."
    }
  },
  "required": [
    "schemaVersion",
    "schema",
    "crops",
    "items"
  ],
  "description": "What a Firstlight rack grows: budgets, harvest, items and artwork of each crop, and the room they grow in."
}
